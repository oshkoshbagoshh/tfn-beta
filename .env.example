# Copy to .env and fill in values. Do not commit .env.

# Optional: Audius (Sandcastle) API key for artist/streaming integrations
# AUDIUS_API_KEY=your_audius_sandcastle_api_key

# Optional: Spotify (for pulling artist data on artist signup)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optional: Pexels (placeholder images)
# PEXELS_API_KEY=

# Django (production)
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Email (production)
# DEVELOPER_EMAIL=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# S3 (production media)
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
